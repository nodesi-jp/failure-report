{
  "name": "@nodesi/failure-report",
  "version": "0.2.0",
  "description": "Playwright の実行から Failure Report（観点・マトリクス・ページごとにお題・前提・内容・判断根拠・結果・スクショ・DB の前後）を作り、見る・配る・MCP で引くための道具",
  "license": "MIT",
  "author": "Nodesi Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodesi-jp/failure-report.git"
  },
  "homepage": "https://github.com/nodesi-jp/failure-report#readme",
  "bugs": {
    "url": "https://github.com/nodesi-jp/failure-report/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "failure-report": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./runContext": {
      "types": "./dist/runContext.d.ts",
      "default": "./dist/runContext.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "default": "./dist/evidence.js"
    },
    "./transfer": {
      "types": "./dist/transfer.d.ts",
      "default": "./dist/transfer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "playwright",
    "reporter",
    "test-report",
    "evidence",
    "e2e",
    "mcp"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
